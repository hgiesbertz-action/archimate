@startuml
title Componenten Diagram - Log Data Ingestie & Distributie

skinparam componentStyle uml2

package "Log Producer Domein" {
    [IoT Apparaat Service] as IoTService <<Component>>
    [Applicatie Server] as AppServer <<Component>>
}

package "Log Verwerking & Transport" {
    component "Log Forwarder\n(FluentBit / Vector)" as LogForwarder
    component "Message Broker\n(Apache Kafka)" as MessageBroker
    component "Log Indexeerder\n(Logstash)" as LogProcessor
}

package "Opslag & Analyse" {
    database "Elasticsearch\n(Data Lake)" as DBElastic
    [Grafana Dashboards] as Grafana
}

' Interfaces definieren
interface "Syslog Protocol" as INT_Syslog
interface "HTTP REST API" as INT_HTTP
interface "Kafka Topic\n(raw-logs)" as INT_Kafka
interface "Bulk Index API" as INT_Bulk

' Koppelingen (Producers naar Forwarder)
IoTService --( INT_Syslog : Log streams sturen
LogForwarder - INT_Syslog

AppServer --( INT_HTTP : JSON logs posten
LogForwarder - INT_HTTP

' Koppelingen (Transport naar Broker en Storage)
LogForwarder --> INT_Kafka : Publiceert batches
INT_Kafka )- MessageBroker

MessageBroker --( INT_Kafka : Consumeert streams
LogProcessor - INT_Kafka

LogProcessor --> INT_Bulk : Transformeert & laadt
INT_Bulk )- DBElastic

DBElastic <- Grafana : Kweert logdata
@enduml

@startuml test

'--- INCLUDE ARCHIMAT LIBRARY ---
!include <archimate/Archimate>

' --- DEFAULT PARAMETERS ----
skinparam roundcorner 5
skinparam shadowing false
' skinparam componentStyle rectangle
' skinparam BACKGROUND_COLOR #FFFFFF
' skinparam NodeBackgroundColor #F5F5F5

' --- OFFICIAL ARCHIMATE COLOR PALETTE ---
!define BUSINESS_COLOR #FFF9C4
!define APPLICATION_COLOR #B2EBF2
!define TECHNOLOGY_COLOR #C8E6C9

hide <<business-interface>> stereotype
hide <<application-component>> stereotype
hide <<data-object>> stereotype
hide <<node>> stereotype
hide <<device>> stereotype
hide <<system-software>> stereotype
hide <<artifact>> stereotype

skinparam Rectangle {
    BackgroundColor<<business-interface>> BUSINESS_COLOR
    BackgroundColor<<application-component>> APPLICATION_COLOR
    BackgroundColor<<data-object>> APPLICATION_COLOR
    BackgroundColor<<node>> TECHNOLOGY_COLOR
    BackgroundColor<<device>> TECHNOLOGY_COLOR
    BackgroundColor<<system-software>> TECHNOLOGY_COLOR
    BackgroundColor<<artifact>> TECHNOLOGY_COLOR
    BorderColor #455A64
    FontColor #212121
}
skinparam Component {
    BackgroundColor<<business-interface>> BUSINESS_COLOR
    BackgroundColor<<application-component>> APPLICATION_COLOR
    BackgroundColor<<data-object>> APPLICATION_COLOR
    BackgroundColor<<node>> TECHNOLOGY_COLOR
    BackgroundColor<<device>> TECHNOLOGY_COLOR
    BackgroundColor<<system-software>> TECHNOLOGY_COLOR
    BackgroundColor<<artifact>> TECHNOLOGY_COLOR
    BorderColor #455A64
    FontColor #212121
}
skinparam Node {
    BackgroundColor<<business-interface>> BUSINESS_COLOR
    BackgroundColor<<application-component>> APPLICATION_COLOR
    BackgroundColor<<data-object>> APPLICATION_COLOR
    BackgroundColor<<node>> TECHNOLOGY_COLOR
    BackgroundColor<<device>> TECHNOLOGY_COLOR
    BackgroundColor<<system-software>> TECHNOLOGY_COLOR
    BackgroundColor<<artifact>> TECHNOLOGY_COLOR
    BorderColor #455A64
    FontColor #212121
}
skinparam Package {
    BackgroundColor #E8F5E9
    BorderColor #81C784
    FontColor #2E7D32
}

'--- START MAIN DIAGRAM ---
title Centrale Log Observabiliteit (Elastic)

' --- BRONSECTOR / APPLICATIES (10+ Bronnen) ---
cloud "Applicatie & Microservices" as ApplicationCloud {
  [Frontend Web App] as WebApp <<application-component>>
  [Backend Java API] as JavaAPI
  [Mobile App Backend] as MobileAPI
  [Legacy Monolith] as Legacy
}

node "Infrastructuur & Cloud" as InfraStructureNode {
  [Active Directory / IAM] as IAM <<system-software>>
  [Kubernetes Clusters (K8s)] as K8s
  [Linux / Windows Servers] as OS
  [AWS CloudWatch / Activity Logs] as CloudLogs
}

node "Network & Security" as NetworkNode {
  [FortiGate] as NW_Firewall <<device>>
  [FortiManager] as NW_Fortimanager <<system-software>>
  [FortiAnalyzer] as NW_FortiAnalyzer <<system-software>>
 
}

' --- SHIPPERS / AGENTS LAAG ---
node "Log Shippers / Collection" as CollectionNode {
  Technology_SystemSoftware(elasticAgent, "Elastic Agent & Beats", "Metric & Packet Collection")
  [Elastic Agent / Filebeat] as AgentApp 
  [FluentBit / Logstash Agent] as AgentInfra
  [Syslog Daemon] as Syslog
}

' --- INGESTION & PROCESSING ---
queue "Message Broker (Optioneel voor Buffering)" as Queue {
  [Logstash] as IngestQueue
}

node "Centrale Verwerking" {
  [Logstash Pipelines] as Logstash
}

'--- EXTERNAL SIEM ---

rectangle "3rd Party" {
    Technology_Node(3rdParty_FoxIT, "FOX-IT", "Evaluation & Forensics")
    Technology_Node(3rdParty_GTT, "GTT Logging", "Network Monitoring")
    Technology_Node(3rdParty_Sentinel, "Microsoft Sentinel", "SIEM & Security Analytics")
}

' --- ELASTIC OBSERVABILITY PLATFORM (Gecorrigeerd naar node) ---
node "Elastic Observability Platform (Single Instance/Cluster)" {
  database "Elasticsearch Cluster" as ES {
    [Data Streams / Indices] as Indices
  }
  Technology_Node(elasticStack, "Elasticsearch & Kibana", "Storage, Indexing & Visualization")
  Application_Component(apmServer, "APM Server & RUM", "Application & End-User Tracing")
  Business_Actor(Kibana, "Kibana Dashboards", "Visualization & Analytics")
}

' --- INTERACTIES / DATASTROMEN ---

'blokken fixeren
IngestQueue --[hidden]-- Logstash
Logstash --[hidden]-- ES

' Koppelingen van bronnen naar agents
WebApp -down-> AgentApp : Log4j / JSON
JavaAPI -down-> AgentApp
MobileAPI -down-> AgentApp
Legacy -down-> AgentApp
K8s --> AgentInfra : Container STDOUT
OS --> AgentInfra : Auth.log / Syslog
CloudLogs --> AgentInfra : API Pull

NW_Firewall --> NW_FortiAnalyzer : Syslog
NW_Firewall --> 3rdParty_GTT : UDP/TCP 514
3rdParty_GTT .. NW_FortiAnalyzer : Syslog Forwarding
IAM --> AgentInfra


' Van Agents naar Ingestion
AgentApp --> IngestQueue : Beats Protocol (Lumberjack)
AgentInfra --> IngestQueue : HTTPS / Kafka Topic
Syslog --> Logstash : Direct Syslog Ingest

' Van Queue naar Elastic
IngestQueue --> Logstash : Verbruikt berichten
Logstash --> ES : Geformatteerde JSON (Bulk API)

' User Interface
Kibana --> ES : Zoeken & Visualiseren


@endum
@startuml
!include <archimate/Archimate>

' --- ELEMENTEN ---
Technology_SystemSoftware(FAZ, "FortiAnalyzer")
Technology_SystemSoftware(SyslogServer, "Centrale Syslog Server")

' De documentatie / parameterlijst als Artifact (Groen)
Technology_Artifact(SyslogSpec, "Syslog RFC 5424 Parameters\n---\n* Facility\n* Severity\n* Hostname\n* MsgID\n* Custom Fortinet Fields")

' --- RELATIES ---
' De informatiestroom (gestippelde lijn voor Flow)
Rel_Flow_Right(FAZ, SyslogServer, "Stuurt logs (Port 514)")

' Koppel het parameter-document aan de stroom (associatie-lijn)
Rel_Association(SyslogSpec, FAZ, "")
@endum
@startuml
!include <archimate/Archimate>

' FortiAnalyzer met daarin de specifieke parameter-output gedefinieerd
Technology_SystemSoftware(FAZ, "FortiAnalyzer") {
    Technology_Artifact(ParamSet, "FortiGate Log Schema\n(Syslog Payload)\n---\n- devid\n- vd\n- logid\n- type\n- subtype")
    Technology_Artifact(SyslogSpec, "Syslog RFC 5424 Parameters\n---\n* Facility\n* Severity\n* Hostname\n---\n[[https://fortinet.com -> Open Fortinet Docs]]")
}

Technology_SystemSoftware(SyslogServer, "Syslog Server")

' Relaties
Rel_Flow_Right(FAZ, SyslogServer, "Verzendt syslog logs")
@endum
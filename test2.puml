@startuml
skinparam componentStyle rectangle
skinparam BACKGROUND_COLOR #FFFFFF
skinparam NodeBackgroundColor #F5F5F5

title UML Componenten Diagram: Centrale Log Observabiliteit (Elastic)

' --- BRONSECTOR / APPLICATIES (10+ Bronnen) ---
cloud "Applicatie & Microservices" {
  [Frontend Web App] as WebApp
  [Backend Java API] as JavaAPI
  [Mobile App Backend] as MobileAPI
  [Legacy Monolith] as Legacy
}

node "Infrastructuur & Cloud" {
  [Kubernetes Clusters (K8s)] as K8s
  [Linux / Windows Servers] as OS
  [AWS CloudWatch / Activity Logs] as CloudLogs
}

node "Netwerk & Beveiliging" {
  [Cisco Firewalls] as Firewall
  [Nginx / HAProxy Load Balancers] as LoadBalancer
  [Active Directory / IAM] as IAM
  [Database Audit Logs (SQL/NoSQL)] as DBLogs
}

' --- SHIPPERS / AGENTS LAAG ---
node "Log Shippers / Collection" {
  [Elastic Agent / Filebeat] as AgentApp
  [FluentBit / Logstash Agent] as AgentInfra
  [Syslog Daemon] as Syslog
}

' --- INGESTION & PROCESSING ---
queue "Message Broker (Optioneel voor Buffering)" as Queue {
  [Apache Kafka / Logstash Queue] as IngestQueue
}

node "Centrale Verwerking" {
  [Logstash Pipelines] as Logstash
}

' --- ELASTIC OBSERVABILITY PLATFORM (Gecorrigeerd naar node) ---
node "Elastic Observability Platform (Single Instance/Cluster)" {
  database "Elasticsearch Cluster" as ES {
    [Data Streams / Indices] as Indices
    [ILM / Retentie Policies] as ILM
  }
  [Kibana Dashboards] as Kibana
  [Elastic APM / Fleet Server] as Fleet
}

' --- INTERACTIES / DATASTROMEN ---

' Koppelingen van bronnen naar agents
WebApp --> AgentApp : Log4j / JSON
JavaAPI --> AgentApp
MobileAPI --> AgentApp
Legacy --> AgentApp

K8s --> AgentInfra : Container STDOUT
OS --> AgentInfra : Auth.log / Syslog
CloudLogs --> AgentInfra : API Pull

Firewall --> Syslog : UDP/TCP 514
LoadBalancer --> AgentInfra : Access Logs
IAM --> AgentInfra
DBLogs --> AgentApp

' Van Agents naar Ingestion
AgentApp --> IngestQueue : Beats Protocol (Lumberjack)
AgentInfra --> IngestQueue : HTTPS / Kafka Topic
Syslog --> Logstash : Direct Syslog Ingest

' Van Queue naar Elastic
IngestQueue --> Logstash : Verbruikt berichten
Logstash --> ES : Geformatteerde JSON (Bulk API)
Fleet --> AgentApp : Centraal Beheer & Policies

' User Interface
Kibana --> ES : Zoeken & Visualiseren

@enduml
